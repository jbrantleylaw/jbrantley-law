# Copy to .env for local work, and set the same variables in Netlify under
# Site configuration -> Environment variables.
#
# Nothing here is required for the portal to run: without an email transport
# the client still signs and downloads their PDF, and the confirmation screen
# tells them to forward it to the firm. Set one of the two transports below to
# get the email delivered automatically.

# ---------------------------------------------------------------------------
# Where signed engagement letters are sent. This is the only value you must
# check before going live.
# ---------------------------------------------------------------------------
MAIL_TO=jbrantley@jenniferbrantleylaw.com

# The "from" address on the notification. It must be on a domain you have
# verified with your email provider, or the message will be rejected.
MAIL_FROM=intake@fineprintlawyer.com
MAIL_FROM_NAME=Client Intake Portal

# ---------------------------------------------------------------------------
# Option 1 (recommended): Resend — https://resend.com
# Free for 3,000 emails/month. Verify fineprintlawyer.com, then paste the key.
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Option 2: any SMTP account (Google Workspace, Microsoft 365, Fastmail…).
# Used only if RESEND_API_KEY is blank or Resend fails.
# For Google Workspace use an App Password, not the account password.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Send the client their own copy of the signed agreement as well.
# ON by default — you do not need to set this. Set it to false to turn it off.
# ---------------------------------------------------------------------------
SEND_CLIENT_COPY=true
